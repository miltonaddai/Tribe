PORT=2567

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis presence / sessions
REDIS_URL=

# Alchemy / RPC (wallet balances)
ALCHEMY_API_KEY=
ALCHEMY_ROBINHOOD_URL=
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ALCHEMY_ROBINHOOD_URL=

# Cloudflare R2 (avatars, clothing, cars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=the-block-assets
R2_PUBLIC_URL=

# Minimum native balance to spawn in each city (highest matching city wins).
# Re-read on each wallet lookup — edit and connect again, no restart needed.
CITY_MIN_ETH_TRENCH=0
CITY_MIN_ETH_GAS=0.005
CITY_MIN_ETH_REALWORLD=0.01
CITY_MIN_ETH_VALHALLA=0.015

# Empty homes go to auction. The clock starts on the first bid.
# Re-read every second, so you can shorten it mid-session while testing.
HOME_AUCTION_SECONDS=86400
HOME_OPENING_BID=250
HOME_BID_INCREMENT=50

# How long a seller has to accept or reject the winning bid before it is
# auto-accepted. Sellers choose their own auction length when they list.
HOME_ACCEPT_WINDOW_SECONDS=86400

# Floor on a seller-chosen auction length. Drop it to a few seconds for testing.
HOME_MIN_AUCTION_SECONDS=60
