# The game socket. Use wss:// in production - a page served over HTTPS cannot
# open an insecure ws:// connection, and the browser blocks it silently.
VITE_COLYSEUS_URL=ws://localhost:2567

# Base URL for the HTTP API (/api/auth, /api/characters, /api/token, ...).
# Leave EMPTY in development: requests stay root-relative and Vite's dev proxy
# forwards them to localhost:2567. Set it in production to the backend's origin
# - the built site is static files on another host, where no such proxy exists
# and a root-relative /api call would hit Netlify instead of the game server.
# No trailing slash. Example: https://your-app.colyseus.cloud
VITE_API_URL=
# Optional JSON array of WebRTC STUN/TURN servers. Add TURN for reliable production voice.
# VITE_VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
# Your X / Twitter profile. The footer icon is hidden until this is set, so a
# guessed handle can never ship as a broken link.
VITE_X_URL=https://x.com/yourhandle

# Reveal the contract address in the site footer. Left unset the footer reads
# "Coming soon", which is the right thing before launch - the configured token
# is a test one, and a test address in the CA slot is what people buy by
# mistake. Set to true when the real token is live.
VITE_TOKEN_LIVE=

# Where the floating buy button sends people.
#
# Pons has no default: a swap URL cannot be derived from the contract address,
# and a guessed one would send people somewhere wrong while trying to spend
# money, so the link is simply absent until this is set.
VITE_PONS_URL=
# Optional. Falls back to a DexScreener search on the contract address, which
# resolves on any chain and works before a trading pair exists. Set this to the
# real pair URL once there is one.
VITE_DEXSCREENER_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to show the floating page / game-mode launcher (bottom right)
VITE_DEV_TOOLS=false

# $TRIBE held to spawn in each district (highest match wins). These only affect
# the dev launcher's demo wallet - a real sign-in takes its district from the
# server, which is the authority. Keep them matching the backend's CITY_MIN_TRIBE_*.
# Restart the frontend after changing these, then reconnect the wallet.
VITE_CITY_MIN_TRIBE_TRENCH=0
VITE_CITY_MIN_TRIBE_GAS=100000
VITE_CITY_MIN_TRIBE_REALWORLD=300000
VITE_CITY_MIN_TRIBE_VALHALLA=500000

# Robinhood Chain network. Must match the backend's CHAIN_* values - the backend
# states CHAIN_ID in the message the wallet signs, and a mismatch means signing
# against a different network than the one the wallet was switched to.
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com
