# Tribe runs as an offline sandbox: no database server, no auth, no chain.
# Every setting here is optional - the server runs with none of them.

PORT=2567

# Where the sandbox database lives. Default: backend/data/sandbox-db.json.
# Set to "memory" to keep nothing between restarts. Delete the file to reset
# the world.
SANDBOX_DB_FILE=

# Simulated Bucks given to each new profile. 2,000,000 buys a home in every
# district.
SANDBOX_STARTING_BUCKS=2000000

# Area-of-interest filtering: clients only receive nearby players. Costs some
# server CPU; worth it with many players.
INTEREST_MANAGEMENT=true

# Log event-loop delay and memory every 2s. Use during load tests.
PERF_LOG=false

# Bucks held by dev launcher demo players decides which district they spawn in.
CITY_MIN_BUCKS_TRENCHES=0
CITY_MIN_BUCKS_BAGTOWN=100000
CITY_MIN_BUCKS_MIDTOWN=300000
CITY_MIN_BUCKS_UPTOWN=500000

# Hard ceiling on cars players may own across the whole world.
MAX_PLAYER_VEHICLES=150
