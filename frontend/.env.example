# Block runs as an offline sandbox against the local game server. Every
# setting here is optional.

# Leave both EMPTY to use the local server: the API goes through Vite's dev
# proxy to localhost:2567, and the game socket goes to port 2567 on whatever
# host served the page (so a second machine on your LAN can join too).
VITE_API_URL=
VITE_COLYSEUS_URL=

# Optional JSON array of WebRTC ICE servers for voice chat. Unset, peers connect
# over host candidates only, which works on one machine or a LAN.
# VITE_VOICE_ICE_SERVERS=[]

# Show the floating page / game-mode launcher (bottom right) with demo players
# for every district.
VITE_DEV_TOOLS=true

# Block Bucks a dev launcher demo player needs to spawn in each district.
# Keep these matching the backend's CITY_MIN_BUCKS_*.
VITE_CITY_MIN_BUCKS_TRENCHES=0
VITE_CITY_MIN_BUCKS_BAGTOWN=100000
VITE_CITY_MIN_BUCKS_MIDTOWN=300000
VITE_CITY_MIN_BUCKS_UPTOWN=500000
