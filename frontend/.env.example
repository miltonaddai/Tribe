VITE_COLYSEUS_URL=ws://localhost:2567
# Optional JSON array of WebRTC STUN/TURN servers. Add TURN for reliable production voice.
# VITE_VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to show the floating page / game-mode launcher (bottom right)
VITE_DEV_TOOLS=false

# $TRIBE held to spawn in each district (highest match wins). These only affect
# the dev launcher's demo wallet - a real sign-in takes its district from the
# server, which is the authority. Keep them matching the backend's CITY_MIN_TRIBE_*.
# Restart the frontend after changing these, then reconnect the wallet.
VITE_CITY_MIN_TRIBE_TRENCH=0
VITE_CITY_MIN_TRIBE_GAS=100000
VITE_CITY_MIN_TRIBE_REALWORLD=300000
VITE_CITY_MIN_TRIBE_VALHALLA=1000000

# Robinhood Chain network. Must match the backend's CHAIN_* values - the backend
# states CHAIN_ID in the message the wallet signs, and a mismatch means signing
# against a different network than the one the wallet was switched to.
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com
