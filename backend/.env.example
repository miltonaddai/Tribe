PORT=2567

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis presence / sessions
REDIS_URL=

# Signs login sessions. REQUIRED in production: at least 32 random characters,
# e.g. `openssl rand -hex 32`. Unset, a random secret is used per boot and every
# restart signs everyone out.
SESSION_SECRET=

# The site(s) players sign wallet messages on, comma-separated, e.g.
# https://moonville.example. Messages for any other site are refused, so a
# lookalike page cannot collect signatures. Leave blank in development.
SITE_ORIGINS=


ALLOW_DEMO_PLAYERS=false

SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_EXPLORER=https://solscan.io

# Cloudflare R2 (avatars, clothing, cars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=the-block-assets
R2_PUBLIC_URL=

# Area-of-interest filtering: clients only receive nearby players. Needed for
# 500 players (~12x less bandwidth per client). Costs some server CPU.
INTEREST_MANAGEMENT=true

# Log event-loop delay and memory every 2s. Use during load tests.
PERF_LOG=false

# --- Moon: the in-game currency is the $MOON SPL token on Solana ---
# Players link a Solana wallet to their account and pay for things by burning
# $MOON from it; the server only reads the chain to confirm the burn landed.
# Nothing is sent to a store wallet. On mainnet-beta the mint defaults to the
# official $MOON address (src/services/token.ts); set this only to point devnet
# at a stand-in SPL token. With no mint, holdings read as zero, everyone starts
# in Trenches, and purchases use the off-chain balance.
MOON_TOKEN_MINT=
MOON_TOKEN_SYMBOL=MOON
# Leave blank. Decimals are read from the mint at boot. Set this only for a
# non-standard mint - a stale value here rescales every balance in the game.
MOON_TOKEN_DECIMALS=

# Moon given to a brand new player. MUST be 0 wherever the token is real:
# a starting balance mints tokens the treasury never received. Set it only on a
# throwaway database so the game stays testable before the token exists.
MOON_DEV_GRANT=0

# District access by $MOON held in the wallet linked to the account. Players
# with no linked wallet hold zero and play in Trenches. Until MOON_TOKEN_MINT is
# set, everyone lands in Trenches - set these to 0 locally to work on the upper
# districts before the token exists.
CITY_MIN_MOON_TRENCHES=0
CITY_MIN_MOON_BAGTOWN=100000
CITY_MIN_MOON_MIDTOWN=300000
CITY_MIN_MOON_UPTOWN=500000

# Hard ceiling on cars players may own across the whole world, ever. Cars
# persist, so without this the fleet only grows. 150 is about a third of a full
# 500-player world - enough that a car is worth having - and spread over four
# districts it keeps the per-district count near what the movement collision
# scan handles comfortably. The six pre-placed street cars are not counted.
MAX_PLAYER_VEHICLES=150
