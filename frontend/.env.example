# The game socket. Use wss:// in production - a page served over HTTPS cannot
# open an insecure ws:// connection, and the browser blocks it silently.
VITE_COLYSEUS_URL=ws://localhost:2567

# Base URL for the HTTP API (/api/accounts, /api/characters, /api/token, ...).
# Leave EMPTY in development: requests stay root-relative and Vite's dev proxy
# forwards them to localhost:2567. Set it in production to the backend's origin
# - the built site is static files on another host, where no such proxy exists
# and a root-relative /api call would hit Netlify instead of the game server.
# No trailing slash. Example: https://your-app.colyseus.cloud
VITE_API_URL=
# Optional JSON array of WebRTC STUN/TURN servers. Add TURN for reliable production voice.
# VITE_VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
# Your X / Twitter profile. The footer icon is hidden until this is set, so a
# guessed handle can never ship as a broken link.
VITE_X_URL=https://x.com/yourhandle



VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to show the floating page / game-mode launcher (bottom right).
# Its demo players only get into the game when the backend runs with
# ALLOW_DEMO_PLAYERS=true.
VITE_DEV_TOOLS=false

# $MOON held to spawn in each district (highest match wins). These only affect
# the dev launcher's demo players - a real account takes its district from the
# server, which is the authority. Keep them matching the backend's CITY_MIN_MOON_*.
VITE_CITY_MIN_MOON_TRENCHES=0
VITE_CITY_MIN_MOON_BAGTOWN=100000
VITE_CITY_MIN_MOON_MIDTOWN=300000
VITE_CITY_MIN_MOON_UPTOWN=500000

# Solana network. Keep VITE_SOLANA_CLUSTER matching the backend's SOLANA_CLUSTER.
# The RPC is only used to fetch a blockhash when a player pays; the public one
# rate-limits browsers hard, so set a dedicated endpoint in production.
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_SOLANA_EXPLORER=https://solscan.io

# Published addresses (base58). Each shows "Coming soon" on the site until set,
# and the buy button stays hidden until there is a mint. These are links people
# follow to spend money, so set them deliberately and check them twice.
VITE_MOON_MINT=
VITE_MOON_DEV_WALLET=
VITE_MOON_STORE_WALLET=

# Firebase, for bug reports written from the pause menu. A web config is not a
# secret - it identifies the project and is visible in any client that talks to
# it - but it lives here so a fork is a deploy setting rather than an edit.
# Unset, the form says reporting is unavailable instead of failing on send.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
