PORT=2567

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis presence / sessions
REDIS_URL=

# Alchemy / RPC (wallet balances)
ALCHEMY_API_KEY=
ALCHEMY_ROBINHOOD_URL=

# Cloudflare R2 (avatars, clothing, cars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=the-block-assets
R2_PUBLIC_URL=

# How long a seller has to accept or reject the winning bid before it is
# auto-accepted. Sellers choose their own auction length when they list.

# Floor on a seller-chosen auction length. Drop it to a few seconds for testing.

# Area-of-interest filtering: clients only receive nearby players. Needed for
# 500 players (~12x less bandwidth per client). Costs some server CPU.
INTEREST_MANAGEMENT=true

# Log event-loop delay and memory every 2s. Use during load tests.
PERF_LOG=false

# --- Tribute: the in-game currency is the $TRIBE token itself ---
# Players deposit real tokens to the treasury and the server credits an in-game
# balance 1:1. Spending draws down that balance with no wallet popup; depositing
# and withdrawing are the signing moments. Any ERC-20 can stand in until $TRIBE
# launches - point TRIBE_TOKEN_ADDRESS at any ERC-20 to exercise the flow.
# Swapping tokens is this one line: decimals, symbol and name follow from the
# contract. Blank means holdings read as zero and everyone starts in Trench.
TRIBE_TOKEN_ADDRESS=
# Leave blank. Decimals are read from the contract at boot so swapping the token
# is a one-line change above. Set this only for a non-standard contract with no
# decimals() function - a stale value here rescales every balance in the game.
TRIBE_TOKEN_DECIMALS=
# Where purchases are paid to. An ADDRESS, never a key: players sign their own
# transfers and the server only reads the chain to confirm one landed, so there
# is no key here that could move anyone's tokens. Leave blank and purchases fall
# back to the off-chain dev balance.
TRIBE_PAYMENT_ADDRESS=

# Tribute given to a brand new wallet. MUST be 0 wherever the token is real:
# a starting balance mints tokens the treasury never received. Set it only on a
# throwaway database so the game stays testable before deposits exist.
TRIBUTE_DEV_GRANT=0

# District access by $TRIBE held (wallet balance + already deposited in-game).
# Under 100,000 tokens is Trench; 1,000,000+ is Valhalla. At a $1M market cap
# (1B supply) that ladder is about $100 / $300 / $1,000, and those dollar
# figures move with the token price. Until TRIBE_TOKEN_ADDRESS is set, on-chain
# holdings read as zero and everyone lands in Trench - set these to 0 locally to
# work on the upper districts before the token exists.
CITY_MIN_TRIBE_TRENCH=0
CITY_MIN_TRIBE_GAS=100000
CITY_MIN_TRIBE_REALWORLD=300000
CITY_MIN_TRIBE_VALHALLA=500000

# Robinhood Chain network. Mainnet by default; testnet is CHAIN_ID=46630 with
# https://rpc.testnet.chain.robinhood.com. CHAIN_ID is also what the sign-in
# message states, so it must match the frontend's VITE_CHAIN_ID or wallets will
# sign against a different network than they were switched to.
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
CHAIN_EXPLORER=https://robinhoodchain.blockscout.com

# Hard ceiling on cars players may own across the whole world, ever. Cars
# persist, so without this the fleet only grows. 150 is about a third of a full
# 500-player world - enough that a car is worth having - and spread over four
# districts it keeps the per-district count near what the movement collision
# scan handles comfortably. The six pre-placed street cars are not counted.
MAX_PLAYER_VEHICLES=150
